{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["scripts/**/*", "demo/**/*", "config/**/*"],
  "exclude": ["node_modules", "contracts", "sdk/dist", "sdk/node_modules"]
}
