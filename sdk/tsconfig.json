{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "../config/ens.config.ts"],
  "exclude": ["node_modules", "dist"]
}
