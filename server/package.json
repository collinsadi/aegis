{
  "name": "@0xaegis/gateway",
  "version": "1.0.0",
  "description": "Aegis CCIP-Read gateway — serves full ML-DSA public keys off-chain",
  "main": "dist/index.js",
  "scripts": {
    "dev":       "ts-node-dev --respawn src/index.ts",
    "build":     "tsc && prisma generate",
    "start":     "prisma migrate deploy && node dist/index.js",
    "clean":     "rm -rf dist",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "cors":           "^2.8.5",
    "dotenv":         "^16.4.5",
    "ethers":         "^6.11.0",
    "express":        "^4.19.2",
    "helmet":         "^7.1.0",
    "morgan":         "^1.10.0",
    "prisma":         "^5.13.0"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan":  "^1.9.9",
    "@types/node":    "^20.0.0",
    "ts-node":        "^10.9.2",
    "ts-node-dev":    "^2.0.0",
    "typescript":     "^5.4.0"
  }
}
