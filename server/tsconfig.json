{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "commonjs",
    "esModuleInterop":   true,
    "resolveJsonModule": true,
    "strict":            false,
    "outDir":            "dist",
    "rootDir":           "src",
    "skipLibCheck":      true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
