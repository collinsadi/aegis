PORT=8080
DATABASE_URL=postgresql://aegis:secret@localhost:5432/aegis
AEGIS_RESOLVER_ADDRESS=0x...
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NODE_ENV=production

# ── 0G Integration (optional) ──────────────────────────────────────────
# Set ENABLE_ZERO_G=true to activate persistent key storage and AI threat scoring.
# Leave unset or set to false to use in-memory store and hardcoded oracle weights.

ENABLE_ZERO_G=true
ZERO_G_PRIVATE_KEY=            # Funded 0G testnet wallet private key
ZERO_G_STORAGE_RPC=https://evmrpc-testnet.0g.ai
ZERO_G_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_COMPUTE_ENDPOINT=https://api.0g.ai/v1
ZERO_G_COMPUTE_MODEL=qwen3.6-plus
