{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "contracts/**/*",
    "ignition/**/*",
    "test/**/*",
    "scripts/**/*",
    "hardhat.config.ts"
  ],
  "exclude": ["node_modules", "dist", "artifacts", "cache"]
}
