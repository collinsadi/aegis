# Sepolia RPC endpoint used by contracts/hardhat.config.ts
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Deployer private key used by contracts/hardhat.config.ts
# Keep 0x prefix.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Etherscan API key used for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional network-specific key (takes precedence for Sepolia if set)
ETHERSCAN_API_KEY_SEPOLIA=YOUR_ETHERSCAN_API_KEY
